# =============================================================
# .env.example — Template cho file .env
# HƯỚNG DẪN: Copy file này thành `.env`, điền giá trị thực
#            TUYỆT ĐỐI KHÔNG commit file `.env` lên Git
# =============================================================

# ── Node Environment ─────────────────────────────────────────
NODE_ENV=production

# ── Server ───────────────────────────────────────────────────
PORT=5000

# ── MongoDB ──────────────────────────────────────────────────
# URI kết nối MongoDB Atlas (database: web-data)
# Cú pháp: mongodb+srv://<user>:<password>@<cluster>/<dbname>?appName=<app>
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.73klsux.mongodb.net/web-data?appName=Cluster0

# ── JWT ──────────────────────────────────────────────────────
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_and_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Docker Hub (chỉ cần trên VPS / CI environment) ───────────
DOCKERHUB_USERNAME=your_dockerhub_username
IMAGE_TAG=latest
